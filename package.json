{
  "name": "minigame-hub",
  "version": "1.0.0",
  "description": "Full-stack Minigame Portal with Authentication, Leaderboards, Shop & Games",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "npm install && npm --prefix frontend install && npm --prefix frontend run build",
    "dev": "node --watch index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "minigames",
    "fullstack",
    "express",
    "game-hub"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0"
  }
}
